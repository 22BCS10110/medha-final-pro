# ── Backend API ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── NFC Reader Service ───────────────────────────────────────────────
VITE_NFC_API_URL=http://localhost:8010
VITE_NFC_API_USER=
VITE_NFC_API_PASSWORD=

# ── Frontend App URL ─────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173

# ── Patient Mobile App URL ───────────────────────────────────────────
VITE_PATIENT_APP_URL=http://localhost:5173/patient/app
